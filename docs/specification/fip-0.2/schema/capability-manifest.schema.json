{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fip:0.2:capability-manifest",
  "title": "FIP 0.2 Capability Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion", "adapterId", "targetType", "targetVersion", "adapterVersion",
    "acceptsFipVersions", "kinds", "operations", "locatorForms", "protocolFamilies",
    "protocolConstraints", "capabilities", "effects", "auditStrengths", "compositions",
    "approval", "precision", "substrate", "dangerousDefaults"
  ],
  "properties": {
    "manifestVersion": {"const": "0"},
    "adapterId": {"$ref": "urn:fip:0.2:common#/$defs/id"},
    "targetType": {"type": "string", "minLength": 1},
    "targetVersion": {"type": "string", "minLength": 1},
    "adapterVersion": {"type": "string", "minLength": 1},
    "acceptsFipVersions": {
      "type": "array",
      "contains": {"const": "0.2"},
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "kinds": {
      "type": "array",
      "items": {"$ref": "urn:fip:0.2:common#/$defs/kind"}
    },
    "operations": {
      "type": "array",
      "items": {"$ref": "urn:fip:0.2:common#/$defs/operation"}
    },
    "locatorForms": {
      "type": "array",
      "items": {
        "enum": [
          "path", "host", "port", "uri", "serviceId", "executableId",
          "modelId", "deviceId", "channelId"
        ]
      }
    },
    "protocolFamilies": {
      "type": "array",
      "items": {"enum": ["http", "mcp", "graphql", "websocket", "json-rpc", "custom"]}
    },
    "protocolConstraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilityId", "kinds", "lifetimes"],
        "properties": {
          "capabilityId": {"$ref": "urn:fip:0.2:common#/$defs/id"},
          "kinds": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "urn:fip:0.2:common#/$defs/kind"}
          },
          "lifetimes": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "urn:fip:0.2:common#/$defs/lifetime"}
          }
        }
      }
    },
    "effects": {
      "type": "array",
      "items": {"$ref": "urn:fip:0.2:common#/$defs/effect"}
    },
    "auditStrengths": {
      "type": "array",
      "items": {"$ref": "urn:fip:0.2:common#/$defs/auditStrength"}
    },
    "compositions": {
      "type": "array",
      "items": {"$ref": "urn:fip:0.2:common#/$defs/composition"}
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionGate"],
      "properties": {
        "actionGate": {"type": "boolean"},
        "policyMutation": {"type": "boolean"}
      }
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filesystemOperations", "networkHost", "httpMethod", "httpPath",
        "modelId", "credentialDisclosures", "traceCorrelation"
      ],
      "properties": {
        "filesystemOperations": {"enum": ["exact", "bundle"]},
        "networkHost": {"enum": ["exact", "unrestricted"]},
        "httpMethod": {"type": "boolean"},
        "httpPath": {"type": "boolean"},
        "modelId": {"type": "boolean"},
        "credentialDisclosures": {
          "type": "array",
          "items": {"enum": ["none", "proxy-mediated", "process-visible"]}
        },
        "credentialBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimensions", "required"],
          "properties": {
            "dimensions": {
              "type": "array",
              "items": {"enum": ["provider", "host", "port", "path", "protocol"]}
            },
            "required": {
              "type": "array",
              "items": {"enum": ["provider", "host", "port", "path", "protocol"]}
            }
          }
        },
        "traceCorrelation": {"type": "boolean"}
      }
    },
    "substrate": {
      "type": "array",
      "items": {"$ref": "urn:fip:0.2:common#/$defs/substrateEntry"}
    },
    "dangerousDefaults": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
