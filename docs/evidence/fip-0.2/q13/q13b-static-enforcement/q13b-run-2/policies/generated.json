{
  "version": 1,
  "filesystem_policy": {
    "include_workdir": false,
    "read_only": [
      "/mission/*",
      "/usr",
      "/lib",
      "/etc",
      "/app",
      "/var/log",
      "/proc",
      "/dev/urandom",
      "/run/openshell-supervisor-ca"
    ],
    "read_write": [
      "/tmp",
      "/dev/null"
    ]
  },
  "landlock": {
    "compatibility": "hard_requirement"
  }
}
